{
  "defaultEngine": "patchright",
  "headless": true,
  "allowPrivateNetwork": false,
  "allowFileUrls": false,
  "humanize": true,
  "blockTrackers": true,
  "locale": "en-US",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "timeout": {
    "navigationMs": 45000,
    "actionMs": 10000,
    "settleMs": 400
  },
  "redactParams": [
    "token",
    "access_token",
    "api_key",
    "apikey",
    "password",
    "secret",
    "code"
  ],
  "trackerAllowlist": [],
  "profile": "flash",
  "riskyActionPolicy": "warn",
  "memoryPath": "~/.cache/browser-mcp/site-memory.json",
  "proxyPool": [],
  "proxyOptions": {
    "mode": "round-robin",
    "matchGeo": true,
    "testOnLaunch": false,
    "rotateOnError": true,
    "healthCheckUrl": "https://ipapi.co/json/",
    "geoLookupUrl": "https://ipapi.co/json/",
    "timeoutMs": 15000
  },
  "audit": true,
  "auditPath": "~/.cache/browser-mcp/audit.jsonl",
  "idleTimeoutMs": 0
}
